DATABASE_URL=postgres://postgres:postgres@localhost:5432/forma
# Сгенерируйте свой секрет: openssl rand -hex 48
JWT_SECRET=replace-with-long-random-string
PORT=3001
# 127.0.0.1 — слушать только локально (за nginx); по умолчанию 0.0.0.0
# HOST=127.0.0.1
# За nginx или другим прокси:
# TRUST_PROXY=1
# Для облачной базы (Neon, Supabase, внешний адрес Render) раскомментируйте:
# DATABASE_SSL=true